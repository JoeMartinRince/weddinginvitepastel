ElFSCLNEXqFr2Io2MSNlD9dY.0ng6hpj.jpg 1200w" src="assets/framerusercontent.com/images/mGElFSCLNEXqFr2Io2MSNlD9dY.0ng6hpj.jpg" alt="The two of us, early on" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div></div></div><div class="framer-12f3xoe hidden-10wpip2 hidden-1w3x1co" data-framer-name="Story Image B"><div class="framer-1j52tdm" data-framer-name="Photo" style="will-change:transform;opacity:1;transform:none"><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" loading="lazy" width="1200" height="1798" sizes="(min-width: 1200px) 268px, (min-width: 810px) and (max-width: 1199.98px) 268px, (max-width: 809.98px) 268px" srcset="assets/framerusercontent.com/images/t9NEyx6nxSYG2rFU0nJkt3ThHoM.0mdyq0g.jpg 683w, assets/framerusercontent.com/images/t9NEyx6nxSYG2rFU0nJkt3ThHoM.0ng6hpj.jpg 1200w" src="assets/framerusercontent.com/images/t9NEyx6nxSYG2rFU0nJkt3ThHoM.0ng6hpj.jpg" alt="A quiet moment" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div></div><div class="framer-amf3ud" data-framer-name="Story Text"><div class="framer-1kxrb8" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto">Our Story</p></div><div class="framer-1kvjjvx" data-framer-name="Story Heading" data-framer-component-type="RichTextContainer" style="transform:none"><h2 class="framer-text framer-styles-preset-58sivt" data-styles-preset="hKRwdtKXO" dir="auto">Eight summers, two cities, and <em class="framer-text">one very long yes</em>.</h2></div><div class="framer-x6b8b0" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">We met on the wrong train to Bologna and spent the whole ride pretending we had meant to be there. Everything since has followed roughly the same pattern — unplanned, a little inconvenient, and somehow exactly right.</p></div><div class="framer-svjujp" data-framer-name="Rule"></div><div class="framer-1537x9d" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-r7pppn" data-styles-preset="binl6AnLt" dir="auto">and now, a wedding</p></div></div></div></section><section as="section" class="framer-v1al4l" data-framer-name="The Day" id="the-day"><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" loading="lazy" width="7441" height="4961" sizes="(min-width: 1200px) 100vw, (min-width: 810px) and (max-width: 1199.98px) 100vw, (max-width: 809.98px) 100vw" srcset="assets/framerusercontent.com/images/gMdz01wkHfWCx2tg4ahKglOPCXQ.1dfb5kx.jpg 512w, assets/framerusercontent.com/images/gMdz01wkHfWCx2tg4ahKglOPCXQ.1j1i9w8.jpg 1024w, assets/framerusercontent.com/images/gMdz01wkHfWCx2tg4ahKglOPCXQ.1q0i3bz.jpg 2048w, assets/framerusercontent.com/images/gMdz01wkHfWCx2tg4ahKglOPCXQ.1353jj0.jpg 4096w, assets/framerusercontent.com/images/gMdz01wkHfWCx2tg4ahKglOPCXQ.0q30s2n.jpg 7441w" src="assets/framerusercontent.com/images/gMdz01wkHfWCx2tg4ahKglOPCXQ.0q30s2n.jpg" alt style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div><div class="framer-1szvij8" data-framer-name="Header Row" style="will-change:transform;opacity:0;transform:translateY(24px)"><div class="framer-1ccckcq" data-framer-name="Title"><div class="framer-yrelsc" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto" style="--framer-text-alignment:center">The day of</p></div><div class="framer-13bgcot" data-framer-component-type="RichTextContainer" style="transform:none"><h2 class="framer-text framer-styles-preset-58sivt" data-styles-preset="hKRwdtKXO" dir="auto" style="--framer-text-alignment:center"><span style="white-space:nowrap"><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">T</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">h</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">e</span></span> <span style="white-space:nowrap"><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">s</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">c</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">h</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">e</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">d</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">u</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">l</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">e</span></span></h2></div></div></div><div class="framer-e2sxcu" data-framer-name="Schedule Rows" style="will-change:transform;opacity:0;transform:translateY(40px)"><div class="framer-1jm134y" data-framer-name="Ceremony Row"><div class="framer-aykasx" data-framer-name="Image"><div class="ssr-variant"><div class="framer-1x4bkd4" data-framer-name="Photo" style="will-change:transform;opacity:1;transform:translateY(-44px)"><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" loading="lazy" width="1400" height="933" sizes="(min-width: 1200px) 640px, (max-width: 809.98px) min(100vw - 40px, 1080px), (min-width: 810px) and (max-width: 1199.98px) min(100vw - 56px, 1080px)" srcset="assets/framerusercontent.com/images/kTxBYLngFqKB7fdCgPAz5bgTUs.0g7mhij.jpg 512w, assets/framerusercontent.com/images/kTxBYLngFqKB7fdCgPAz5bgTUs.1x386x0.jpg 1024w, assets/framerusercontent.com/images/kTxBYLngFqKB7fdCgPAz5bgTUs.1jtc1g5.jpg 1400w" src="assets/framerusercontent.com/images/kTxBYLngFqKB7fdCgPAz5bgTUs.1jtc1g5.jpg" alt="The ceremony" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div></div></div><div class="framer-1rdubgw" data-framer-name="Card"><svg class="framer-TZPAi framer-1z0v4xd" role="presentation" viewBox="0 0 24 24"><use href="#3544325578"/></svg><div class="framer-8n7oym" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">The Ceremony</h3></div><div class="framer-1ae889a" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">In the cypress garden, beneath the old stone arch. Please arrive a little early; the gate is slower than it looks.</p></div><div class="framer-1od19gg" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto" style="--framer-text-color:var(--token-31154fa6-4262-441e-8566-2a719422af51)">Half past four</p></div></div></div><div class="framer-132t29a" data-framer-name="Aperitivo Row"><div class="framer-d2u7nd" data-framer-name="Image"><div class="ssr-variant"><div class="framer-vjwuhn" data-framer-name="Photo" style="will-change:transform;opacity:1;transform:translateY(-44px)"><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" loading="lazy" width="1400" height="934" sizes="(min-width: 1200px) 640px, (max-width: 809.98px) min(100vw - 40px, 1080px), (min-width: 810px) and (max-width: 1199.98px) min(100vw - 56px, 1080px)" srcset="assets/framerusercontent.com/images/l3QdsOXqpyngk98Bxp2IEDfY7w.0hlkhze.jpg 512w, assets/framerusercontent.com/images/l3QdsOXqpyngk98Bxp2IEDfY7w.1wt8l81.jpg 1024w, assets/framerusercontent.com/images/l3QdsOXqpyngk98Bxp2IEDfY7w.1hvetlc.jpg 1400w" src="assets/framerusercontent.com/images/l3QdsOXqpyngk98Bxp2IEDfY7w.1hvetlc.jpg" alt="Aperitivo on the terrace" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div></div></div><div class="framer-1def9tn" data-framer-name="Card"><svg class="framer-slfmX framer-ibk8p7" role="presentation" viewBox="0 0 24 24"><use href="#1297814229"/></svg><div class="framer-173bh5y" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">Aperitivo</h3></div><div class="framer-9gw00s" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">Prosecco and small good things on the lower terrace, while the light goes gold over the valley.</p></div><div class="framer-1n9lkqm" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto" style="--framer-text-color:var(--token-31154fa6-4262-441e-8566-2a719422af51)">Half past five</p></div></div></div><div class="framer-15weti8" data-framer-name="Dinner Row"><div class="framer-pct78j" data-framer-name="Image"><div class="ssr-variant"><div class="framer-8ly6jb" data-framer-name="Photo" style="will-change:transform;opacity:1;transform:translateY(-44px)"><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" loading="lazy" width="1400" height="930" sizes="(min-width: 1200px) 640px, (max-width: 809.98px) min(100vw - 40px, 1080px), (min-width: 810px) and (max-width: 1199.98px) min(100vw - 56px, 1080px)" srcset="assets/framerusercontent.com/images/wDwPs0EqF5YLU9BJB7T86uYOJVs.0ghm37i.jpg 512w, assets/framerusercontent.com/images/wDwPs0EqF5YLU9BJB7T86uYOJVs.1xx6zzx.jpg 1024w, assets/framerusercontent.com/images/wDwPs0EqF5YLU9BJB7T86uYOJVs.1izd8d8.jpg 1400w" src="assets/framerusercontent.com/images/wDwPs0EqF5YLU9BJB7T86uYOJVs.1izd8d8.jpg" alt="One long table under the olive trees" style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div></div></div><div class="framer-ywy6qm" data-framer-name="Card"><svg class="framer-7LCo3 framer-1lopdc6" role="presentation" viewBox="0 0 24 24"><use href="#301676797"/></svg><div class="framer-1ixd2mj" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">Dinner &amp; Dancing</h3></div><div class="framer-wfvn12" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">One long table under the olive trees, too many toasts, and dancing until somebody turns the music off.</p></div><div class="framer-ph5929" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto" style="--framer-text-color:var(--token-31154fa6-4262-441e-8566-2a719422af51)">Eight o’clock</p></div></div></div></div></section><section class="framer-z4nzwv" data-framer-name="Details" id="details"><div class="framer-1unfjkt" data-framer-name="Header Row" style="will-change:transform;opacity:0;transform:translateY(24px)"><div class="framer-12nncgn" data-framer-name="Title"><div class="framer-13gel78" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto" style="--framer-text-alignment:center">Good to know</p></div><div class="framer-1qnkv24" data-framer-component-type="RichTextContainer" style="transform:none"><h2 class="framer-text framer-styles-preset-58sivt" data-styles-preset="hKRwdtKXO" dir="auto" style="--framer-text-alignment:center"><span style="white-space:nowrap"><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">A</span></span> <span style="white-space:nowrap"><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">f</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">e</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">w</span></span> <span style="white-space:nowrap"><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">d</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">e</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">t</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">a</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">i</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">l</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">s</span></span></h2></div></div></div><div class="framer-puv5uw" data-framer-name="Detail Columns" style="will-change:transform;opacity:0;transform:translateY(30px)"><div class="framer-1muling" data-framer-name="Dress Code"><svg class="framer-FVcUF framer-4mdphk" role="presentation" viewBox="0 0 24 24"><use href="#2339096416"/></svg><div class="framer-73ehi1" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">Dress Code</h3></div><div class="framer-p8kr94" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">Black tie optional, in whatever colour makes you feel wonderful. The garden is grass and gravel — choose your heels kindly.</p></div></div><div class="framer-1oncaby" data-border="true" data-framer-name="Where to Stay"><svg class="framer-RWmD6 framer-ecm3ng" role="presentation" viewBox="0 0 24 24"><use href="#3655267681"/></svg><div class="framer-1envmxn" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">Where to Stay</h3></div><div class="framer-hx6i3e" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">We are holding rooms at Villa Sorella and at Pensione Aurora, five minutes down the hill. Mention our names when you book.</p></div></div><div class="framer-11o0az8" data-border="true" data-framer-name="Getting There"><svg class="framer-ESaPQ framer-tmhsjm" role="presentation" viewBox="0 0 24 24"><use href="#216244643"/></svg><div class="framer-1wv5psg" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">Getting There</h3></div><div class="framer-1wx8mf6" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">Fly into Florence or Pisa, then it is a short drive up through the olive groves. Shuttles leave the piazza at four.</p></div></div><div class="framer-1t5l9y8" data-border="true" data-framer-name="Gifts"><svg class="framer-Fnm6u framer-e49evv" role="presentation" viewBox="0 0 24 24"><use href="#2872249251"/></svg><div class="framer-153pdd" data-framer-component-type="RichTextContainer" style="transform:none"><h3 class="framer-text framer-styles-preset-1pgpgy7" data-styles-preset="FpQlF8rVB" dir="auto">Gifts</h3></div><div class="framer-10zblev" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-i3aj53" data-styles-preset="y4yJj4yN2" dir="auto">Your being there is the whole of it. If you would like to give something anyway, there is a small registry linked in your invitation.</p></div></div></div></section><section class="framer-e9dfmk" data-framer-name="Gallery" id="gallery"><div class="framer-agwfhg" data-framer-name="Gallery Header" style="will-change:transform;opacity:0;transform:translateY(24px)"><div class="framer-1l6i08m" data-framer-component-type="RichTextContainer" style="transform:none"><p class="framer-text framer-styles-preset-19qc51q" data-styles-preset="Y3rhPwKFt" dir="auto" style="--framer-text-alignment:center">A few of our favourites</p></div><div class="framer-xu3iv4" data-framer-component-type="RichTextContainer" style="transform:none"><h2 class="framer-text framer-styles-preset-58sivt" data-styles-preset="hKRwdtKXO" dir="auto" style="--framer-text-alignment:center"><span style="white-space:nowrap"><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">M</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">o</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">m</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">e</span><span style="display:inline-block;opacity:0.001;filter:blur(5px);transform:translateX(0px) translateY(26px) scale(1) rotate(0deg) skewX(0deg) skewY(0deg)">n</span><span style="display:inline-block;opa